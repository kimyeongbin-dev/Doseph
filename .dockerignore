# =========================================
# 1. 의존성 및 빌드 결과물 (Node.js & Python)
# =========================================
# Frontend
**/node_modules/
**/.next/
**/out/
**/build/
**/.pnp/
**/.pnp.js
**/.yarn/

# Backend & AI Worker
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/*.egg-info/
**/.eggs/

# =========================================
# 2. IDE, OS 및 에디터 설정
# =========================================
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# =========================================
# 3. 환경 변수 및 로그 (보안 및 용량)
# =========================================
**/.env
**/.env.*
!**/.env.example
**/envs/
**/*.log
**/logs/
**/logs.prev/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
server_log.txt

# =========================================
# 3-1. Secret / 인증 파일 (안전망)
# =========================================
**/*.pem
**/*.key
**/id_rsa
**/id_rsa.*
**/credentials
**/.docker/
**/.aws/
**/.ssh/

# =========================================
# 4. Git 및 Docker 설정
# =========================================
.git/
.github/
**/docker-compose*.yml
**/Dockerfile
**/.dockerignore

# =========================================
# 5. 문서, 테스트 및 기타 불필요한 파일
# =========================================
README.md
**/README.md
docs/
docs-private/
csv/
nginx/
# 🔧 개발 전용 도구 — 런타임은 쓰지 않는다(2026-09-21 실측: app/·ai_worker/ 의
# 비-테스트 코드에서 `import scripts` 0건. 3건 전부 app/tests/ 안이고 그건 아래에서 제외된다).
# 776 KB 가 이미지에 실려 있었고, 더 큰 비용은 **게이트를 한 줄 고칠 때마다 BE 가 재배포**되는 것이었다
# (deploy.yml 의 paths-ignore 는 deny-list 라 scripts/ 가 없으면 배포가 돈다).
# VM 에서 일회성으로 필요하면 그때 올려서 쓰고 지운다(사용자 결정).
scripts/
**/tests/
**/*_test.py
**/test_*.py
**/coverage/
**/htmlcov/

# =========================================
# 6. 캐시 및 빌드 아티팩트
# =========================================
**/.ruff_cache/
**/.pytest_cache/
**/.coverage

# =========================================
# 7. DB dump / 식약처 sync 백업 (이미지에 포함되면 layer 폭증)
# =========================================
medicine_data*.sql
medicine_data*.sql.gz
*.sql.gz
ai_worker/data/medicines_*.ndjson
ai_worker/data/medicines_*.json
