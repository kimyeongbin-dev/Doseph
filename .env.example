# ============================================================
# Doseph 환경 변수 템플릿
# ============================================================
# 사용법 (최초 1회):
#   cp .env.example .env     # 이후 아래 값들을 실제 값으로 채운다
#
# - 실값 파일 `.env` 는 git 미추적(gitignore). 이 템플릿만 커밋된다.
# - 환경 전환 스크립트는 없다. 환경 구분은 아래 [1] ENV 한 줄로 한다.
# - 로컬 스택(docker-compose.yml)과 프론트(dotenv -e ../.env) 모두 이 `.env` 를 읽는다.
# - 프로덕션 실값은 저장소에 두지 않는다(서버측 `.env` + GitHub Actions secrets).
#   프로드 키 목록 참고: envs/example.gcp-login.env
# ============================================================

# ============================================================
# [1] 환경 선택 — 이 한 줄이 URL/쿠키/로그인 버튼을 결정한다
# ============================================================
# local: 로컬 Docker. 카카오 로그인이 mock IdP(테스트 대역)로 동작한다.
#        mock 라우터(/api/v1/mock/kakao/*)는 이 값이 local 일 때만 등록된다.
# dev  : 로컬 Docker. 실제 카카오 서버로 로그인(실테스트용).
# prod : 배포 환경 (공개 URL 을 .env 로 반드시 주입, 아래 [7] 참고)
#
# ※ 필수값이다(기본값 없음). 미설정 시 앱이 기동 단계에서 실패한다 — 설정 유실 시
#    안전하지 않은 쪽(local)으로 조용히 떨어지는 것을 막기 위한 fail-closed 설계.
# ※ 개발자 로그인 백도어는 보안 하드닝으로 제거됐다(어느 환경에서도 없음).
ENV=local

# ============================================================
# [2] 보안 (필수)
# ============================================================
SECRET_KEY=your-secret-key-here
DB_PASSWORD=your-db-password

# ============================================================
# [3] 카카오 OAuth (필수)
# ============================================================
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ============================================================
# [4] DB & Redis
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=doseph_admin
DB_NAME=doseph_db
REDIS_URL=redis://redis:6379/0
# 관리형 PostgreSQL(Neon 등) TLS 연결 시 true. 로컬 Docker 는 false.
# DB_SSL=false

# ============================================================
# [5] 외부 API (선택 — 미설정 시 해당 기능만 비활성)
# ============================================================
# OPENAI_API_KEY=
# DATA_GO_KR_API_KEY=
# DATA_GO_KR_RECALL_API_KEY=
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET_KEY=

# ============================================================
# [6] 로깅 (선택)
# ============================================================
# 파일 로그 위치. 미설정 시 /app/logs (컨테이너 기준).
# LOG_DIR=/app/logs

# ============================================================
# [7] 프론트엔드 (NEXT_PUBLIC_* — 브라우저 번들에 임베드됨)
# ============================================================
# 주의: NEXT_PUBLIC_* 는 브라우저로 그대로 나간다. 시크릿 금지.
# ENV 와 동일하게 맞춘다(프론트가 환경별 기본값을 고르는 기준).
NEXT_PUBLIC_ENV=local

# NEXT_PUBLIC_API_BASE_URL — 로컬에서는 설정하지 말 것.
#   FE 는 미설정 시 medication-frontend/src/config/env.js 의 환경별 기본값을 쓴다
#   (local/dev = http://localhost:8000). 여기에 값을 적으면 그 값이 기본값을 덮어쓰므로,
#   토폴로지가 바뀌었을 때 이 줄만 낡아 조용히 깨진다(실제로 :80 을 가리켜 깨진 이력 있음).
#   프로덕션에서는 반드시 주입한다(CI/배포가 https://api.doseph.com 주입).
# NEXT_PUBLIC_API_BASE_URL=

# ============================================================
# [8] ENV 에 따라 백엔드가 자동 적용하는 값 (app/core/config.py)
# ============================================================
# local / dev:
#   COOKIE_DOMAIN=localhost
#   API_BASE_URL=http://localhost:8000
#   FRONTEND_URL=http://localhost:3000
#   KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
#
# prod: 하드코딩 폴백 없음(플랫폼 중립, 12-factor).
#   API_BASE_URL / FRONTEND_URL 을 .env 로 반드시 주입해야 하며,
#   누락 시 기동 단계에서 차단된다. COOKIE_DOMAIN 미설정 = host-only 쿠키.
