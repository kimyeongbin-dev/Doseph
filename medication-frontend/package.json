{
  "name": "medication-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev --turbopack",
    "build": "dotenv -e ../.env -- npm run build:pages",
    "build:pages": "next build && node scripts/inject-csp-hashes.mjs",
    "start": "next start",
    "verify:headers": "node scripts/verify-headers.mjs",
    "test:headers": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "serve:static": "serve out -l 3000 --no-port-switching",
    "test:e2e": "dotenv -e ../.env -- playwright test",
    "test:e2e:ui": "dotenv -e ../.env -- playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4",
    "vitest": "^5.0.0"
  }
}
