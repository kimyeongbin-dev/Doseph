{
  "name": "medication-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-ocr-assets.mjs",
    "dev": "dotenv -e ../.env -- next dev --turbopack",
    "build": "dotenv -e ../.env -- npm run build:pages",
    "build:pages": "node scripts/fetch-ocr-assets.mjs && next build && node scripts/inject-csp-hashes.mjs && node scripts/fetch-ocr-assets.mjs --verify-build",
    "fetch:ocr": "node scripts/fetch-ocr-assets.mjs",
    "start": "next start",
    "verify:headers": "node scripts/verify-headers.mjs",
    "test:headers": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "serve:static": "serve out -l 3000 --no-port-switching",
    "test:e2e": "dotenv -e ../.env -- playwright test",
    "test:e2e:ui": "dotenv -e ../.env -- playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.1",
    "axios": "^1.21.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "onnxruntime-web": "1.31.1",
    "ppu-paddle-ocr": "6.6.1",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "serve": "^14.2.4",
    "tailwindcss": "^4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "compression": "^1.8.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
