{
  "name": "medication-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev --turbopack",
    "build": "dotenv -e ../.env -- next build",
    "build:local": "dotenv -e ../.env -- next build",
    "start": "next start",
    "lint": "eslint",
    "serve:static": "serve out -l 3000 --no-port-switching",
    "test:e2e": "dotenv -e ../.env -- playwright test",
    "test:e2e:ui": "dotenv -e ../.env -- playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "serve": "^14.2.4",
    "tailwindcss": "^4"
  }
}
